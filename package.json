{
  "name": "sevnt-studio",
  "productName": "SEVNT Studio",
  "version": "1.0.0",
  "description": "SEVNT Studio — Electron desktop app for AI-driven short-form clipping (yt-dlp + ffmpeg + LLM hook titles).",
  "main": "sevnt-main.js",
  "author": "Seventy",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "ffmpeg-static": "5.3.0",
    "qrcode": "^1.5.4"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true,
    "electron@33.4.11": true,
    "@ffprobe-installer/darwin-arm64@5.0.1": true
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "electron": "^45.2.3",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "scripts": {
    "start": "electron .",
    "test": "node tests/run-all.js",
    "test:engine": "node tests/run-engine.js",
    "test:engine:py": "python -m unittest discover -s engine/tests -p \"test_*.py\"",
    "engine:runtime": "node scripts/build-engine-runtime.mjs",
    "build:win": "electron-builder --win --x64",
    "build:win:dir": "electron-builder --win --x64 --dir",
    "build:mac:arm64": "electron-builder --mac --arm64",
    "build:mac:x64": "electron-builder --mac --x64",
    "test:qa:plan": "node --test tests/full-menu-qa-plan.test.js",
    "test:qa:menu-coverage": "playwright test tests/mac-menu-interactions.spec.js --workers=1 --reporter=line,./tests/helpers/full-menu-qa-reporter.cjs"
  }
}
